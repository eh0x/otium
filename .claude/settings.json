{
  "permissions": {
    "deny": [
      "Read(./local.properties)",
      "Read(./keystore.properties)",
      "Read(**/*.jks)",
      "Read(**/*.keystore)",
      "Read(~/.keys/**)",
      "Bash(*local.properties*)",
      "Bash(*keystore.properties*)",
      "Bash(**/*.jks*)",
      "Bash(**/*.keystore*)",
      "Bash(*~/.keys/**)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash|Grep",
        "hooks": [
          {
            "type": "command",
            "command": "/Users/ehoxhaj/.local/bin/graphify hook-guard search",
            "timeout": 10
          }
        ]
      },
      {
        "matcher": "Read|Glob",
        "hooks": [
          {
            "type": "command",
            "command": "/Users/ehoxhaj/.local/bin/graphify hook-guard read",
            "timeout": 10
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/graphify-refresh.sh",
            "timeout": 30
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/docs-reminder.sh",
            "timeout": 10
          }
        ]
      }
    ]
  }
}