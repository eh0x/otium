#!/bin/sh
# Runs static analysis and unit tests before pushing. CI runs the same checks.
# Emergency bypass: git push --no-verify
. "$(dirname "$0")/lib.sh"

# Secret scan of the whole history, which also catches commits made with --no-verify.
if ! "$(dirname "$0")/../scripts/scan-secrets.sh"; then
    echo >&2
    echo "pre-push: possible secret in history. Remove it from the unpushed commits and rotate it." >&2
    exit 1
fi

if ! run_gradle spotlessCheck detekt checkDocs testDebugUnitTest :domain:test; then
    echo >&2
    echo "pre-push: checks failed. Fix them or bypass with --no-verify." >&2
    exit 1
fi

if ! "$(dirname "$0")/../scripts/lint-markdown.sh"; then
    echo >&2
    echo "pre-push: Markdown lint failed (docs/MARKDOWN_GUIDE.md). Fix it or use --no-verify." >&2
    exit 1
fi

# Warns (never blocks) when setup, build or tooling files changed without a docs update.
"$(dirname "$0")/../scripts/docs-impact.sh" || true
