#!/bin/sh
# Blocks commits that break formatting. Fix with: ./gradlew spotlessApply
# Emergency bypass: git commit --no-verify
. "$(dirname "$0")/lib.sh"

if ! run_gradle spotlessCheck; then
    echo >&2
    echo "pre-commit: formatting check failed. Run ./gradlew spotlessApply and re-stage." >&2
    exit 1
fi

# Markdown rules (docs/MARKDOWN_GUIDE.md) on the files being committed. Skips without Node.js.
if ! "$(dirname "$0")/../scripts/lint-markdown.sh" --staged; then
    echo >&2
    echo "pre-commit: Markdown lint failed. Fix the findings above (docs/MARKDOWN_GUIDE.md)." >&2
    exit 1
fi
