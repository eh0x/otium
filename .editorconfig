# Single source of truth for formatting. Read by ktlint (via Spotless), Android Studio and
# most editors. See docs/STYLE_GUIDE.md.
root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 4

# Kotlin follows the Android Kotlin style guide:
# https://developer.android.com/kotlin/style-guide
# ktlint's android_studio code style implements it (4 space indent, 100 column limit).
[*.{kt,kts}]
max_line_length = 100
ktlint_code_style = android_studio

# Project choices on top of the Android guide.
# Trailing commas on multiline declarations and calls (Kotlin coding conventions).
ij_kotlin_allow_trailing_comma = true
ij_kotlin_allow_trailing_comma_on_call_site = true
# Composable functions are named like classes (PascalCase).
ktlint_function_naming_ignore_when_annotated_with = Composable

[*.{yml,yaml,json}]
indent_size = 2

[*.md]
max_line_length = off

[gradlew.bat]
end_of_line = crlf
