// markdownlint rules for every Markdown file. They encode docs/MARKDOWN_GUIDE.md; when a rule
// changes here, change the guide in the same commit (and the other way round).
// A rule that is wrong for one line is turned off on that line, with a reason. A rule that is
// wrong for the whole repository is changed here, with the reason beside it.
{
  "config": {
    "default": true,
    "MD003": { "style": "atx" },
    "MD004": { "style": "dash" },
    "MD007": { "indent": 2 },
    "MD009": { "br_spaces": 0 },
    // 100 columns, the same as the code. Tables, code blocks and headings may run over.
    "MD013": { "line_length": 100, "code_blocks": false, "tables": false, "headings": false },
    // The same heading under different parents is fine.
    "MD024": { "siblings_only": true },
    "MD029": { "style": "one_or_ordered" },
    // The only HTML Markdown has no form for.
    "MD033": { "allowed_elements": ["details", "summary", "b", "br"] },
    "MD046": { "style": "fenced" },
    "MD048": { "style": "backtick" },
    "MD049": { "style": "underscore" },
    "MD050": { "style": "asterisk" },
    // Aligned table pipes make every cell edit rewrite the whole table and its diff.
    "MD060": false
  },
  "ignores": [
    "graphify-out/**", // generated by graphify
    "**/build/**",
    "**/node_modules/**",
    "CLAUDE.md", // managed by the graphify setup and Claude Code; starts with an H2 on purpose
    ".github/pull_request_template.md" // a form that GitHub pastes into a PR, not a document
  ]
}
